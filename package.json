{
  "name": "chordbook",
  "version": "2.0.0",
  "private": true,
  "description": "Chordbook - syllable-level chord/lyric editor (MERN)",
  "main": "server/server.js",
  "scripts": {
    "dev": "npx --yes concurrently -n server,client -c blue,green \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "nodemon server/server.js",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:inspect": "node scripts/migrate.js --inspect",
    "migrate:selftest": "node scripts/selftest.js",
    "test": "jest",
    "test:unit": "jest tests/unit tests/models",
    "test:integration": "jest tests/integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.8.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "chordsheetjs": "^12.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "hyphenation.en-us": "^0.2.1",
    "hypher": "^0.2.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "sanitize-html": "^2.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
