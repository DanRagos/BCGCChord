NODE_ENV=development
PORT=3003

# MongoDB Atlas connection string. Never commit the real value.
MONGODB_URI=

# Origin of the React dev server / production client, used for CORS + cookies.
CLIENT_URL=http://localhost:5173

# Genius API token (https://genius.com/api-clients) — server-side only, never
# sent to the client.
GENIUS_ACCESS_TOKEN=

# Used to sign auth JWTs. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
